{
    "cmake.generator": "Ninja",
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "googletest.failed",
                "settings": {
                    "foreground": "#f00"
                }
            },
            {
                "scope": "googletest.passed",
                "settings": {
                    "foreground": "#0f0"
                }
            },
            {
                "scope": "googletest.run",
                "settings": {
                    "foreground": "#0f0"
                }
            }
        ]
    },
    "cmake.sourceDirectory": "F:/codes/CPP/LearnCPP",
    "cmake.ctest.testSuiteDelimiter": ".",
    "cmake.ctest.parallelJobs": 4,
    // --------------------- C++ TestMate ---------------------
    "testMate.cpp.test.executables": "build/*/bin/LearnCPP_Test.exe",
    "testMate.cpp.test.workingDirectory": "${workspaceFolder}",
    "testMate.cpp.debug.configTemplate": {
        "type": "cppvsdbg",
        "request": "launch",
        "program": "${exec}",
        "args": "${argsArray}",
        "cwd": "${cwd}",
        "env": "${envObj}",
        "console": "integratedTerminal"
    },
    "testMate.cpp.discovery.testListCaching": true,
    "cmake.ctest.neverDebugTestsWithLaunchConfiguration": true
}