{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ctest: run all tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir", "${command:cmake.buildDirectory}",
                "--output-on-failure",
                "-j", "4"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "ctest: run all tests (verbose)",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir", "${command:cmake.buildDirectory}",
                "-V"
            ],
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
